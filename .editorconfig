root = true

[*]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4

# .NET code-style defaults
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:suggestion
csharp_prefer_braces = true:suggestion
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
csharp_space_after_cast = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_new_line_before_open_brace = all

# Naming rules
# Async methods must end in Async.
dotnet_naming_rule.async_methods_should_end_with_async.severity = warning
dotnet_naming_rule.async_methods_should_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_should_end_with_async.style = end_in_async

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.applicable_accessibilities = *
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = PascalCase

# Quality checks
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

dotnet_diagnostic.CS1591.severity = none

dotnet_diagnostic.CA1707.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1812.severity = warning

# Test projects commonly use descriptive underscore-separated names to read clearly.
[test/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none

[src/Voidwell.DaybreakGames.Data/Migrations/**.cs]
generated_code = true

[src/Voidwell.DaybreakGames.Data/DataConfigurations/**.cs]
# Entity type configurations are instantiated by EF via reflection
dotnet_diagnostic.CA1812.severity = none
